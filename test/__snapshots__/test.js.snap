  <div>
    <Child type="text" />
  </div>
);
export default Parent;
",
}
`;

exports[`Nested components with public props should pass public props through parent-child nesting with class components 1`] = `
{
  "Child": "import React from "react";
interface ChildProps {
  type: string;
}
class Child extends React.Component<ChildProps> {
  render() {
    const { type } = this.props;
    return <input type={type} />;
  }
}
export default Child;
",
  "Parent": "import React from "react";
import Child from "./Child";
class Parent extends React.Component {
  render() {
    return (
      <div>
        <Child type="text" />
      </div>
    );
  }
}
export default Parent;
",
}
`;

exports[`TypeScript output should generate TypeScript interface for class components with public props 1`] = `
{
  "Input": "import React from "react";
interface InputProps {
  type: string;
  placeholder: string;
}
class Input extends React.Component<InputProps> {
  render() {
    const { type, placeholder } = this.props;
    return <input type={type} placeholder={placeholder} />;
  }
}
export default Input;
",
}
`;

