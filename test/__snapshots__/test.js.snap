exports[`HTML to React components should generate ES5 React components 1`] = `
{
  "Field": "import React from "react";
import Label from "./Label";
import Input from "./Input";
const Field = React.createClass({
  render() {
    return (
      <div className="field">
        <Label></Label>
        <Input />
      </div>
    );
  },
});
export default Field;
",
  "Form": "import React from "react";
import Field from "./Field";
const Form = React.createClass({
  render() {
    return (
      <form action>
        <Field></Field>
      </form>
    );
  },
});
export default Form;
",
  "Header": "import React from "react";
import Heading from "./Heading";
import Nav from "./Nav";
const Header = React.createClass({
  render() {
    return (
      <header className="header">
        <Heading></Heading>
        <Nav></Nav>
      </header>
    );
  },
});
export default Header;
",
  "Heading": "import React from "react";
const Heading = React.createClass({
  render() {
    return <h1 className="heading">Hello, world!</h1>;
  },
});
export default Heading;
",
  "Input": "import React from "react";
const Input = React.createClass({
  render() {
    return <input type="text" id="input" />;
  },
});
export default Input;
",
  "Label": "import React from "react";
const Label = React.createClass({
  render() {
    return (
      <label htmlFor="input">
        Input<span>label</span>
      </label>
    );
  },
});
export default Label;
",
  "ListItem": "import React from "react";
const ListItem = React.createClass({
  render() {
    return <li className="list-item" />;
  },
});
export default ListItem;
",
  "Main": "import React from "react";
import Form from "./Form";
const Main = React.createClass({
  render() {
    return (
      <main className="main">
        <Form></Form>
      </main>
    );
  },
});
export default Main;
",
  "Nav": "import React from "react";
import ListItem from "./ListItem";
const Nav = React.createClass({
  render() {
    return (
      <nav className="nav">
        <ul className="list">
          <ListItem />
          <ListItem />
        </ul>
      </nav>
    );
  },
});
export default Nav;
",
}
`;

